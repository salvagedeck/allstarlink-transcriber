# AllStarLink Transcriber Configuration
# Copy this file to .env and modify values as needed

# ==========================================
# AllStarLink Connection Settings
# ==========================================

# AllStarLink Node number to connect to
ALLSTARLINK_NODE=9001

# AllStarLink host (hostname or IP)
ALLSTARLINK_HOST=localhost

# AllStarLink IAX2 port
ALLSTARLINK_PORT=4569

# IAX2 authentication username
ALLSTARLINK_USER=guest

# IAX2 authentication password
ALLSTARLINK_PASSWORD=guest

# ==========================================
# Whisper Configuration
# ==========================================

# Whisper model size: tiny, base, small
# tiny   = ~39MB, fastest, lower accuracy
# base   = ~140MB, balanced
# small  = ~244MB, highest accuracy (default)
WHISPER_MODEL=small

# Audio chunk size in seconds for transcription
# 10 = lower latency, more processing
# 30 = balanced
# 60 = higher latency, less processing
AUDIO_CHUNK_SECONDS=10

# ==========================================
# UI Configuration
# ==========================================

# UI Theme: light, dark, high-contrast
UI_THEME=dark

# ==========================================
# Docker/Network Configuration
# ==========================================

# Web server port
WEB_PORT=8000
